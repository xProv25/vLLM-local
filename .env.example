# Environment Configuration Template for vLLM Local Deployment

# Hugging Face Access Token (Required for gated models such as Llama or restricted checkpoints)
HF_TOKEN=your_huggingface_token_here

# Hugging Face Fast Transfer (uses Rust-based multithreaded downloader)
HF_HUB_ENABLE_HF_TRANSFER=1

# vLLM Server Settings
HOST=0.0.0.0
PORT=8000
API_KEY=vllm-local-token

# Target Model
DEFAULT_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# VRAM & Execution Optimization
GPU_MEMORY_UTILIZATION=0.95
MAX_MODEL_LEN=2048
CPU_OFFLOAD_GB=12
ENFORCE_EAGER=1

# GPU Device Selection (0 for single primary GPU)
CUDA_VISIBLE_DEVICES=0
